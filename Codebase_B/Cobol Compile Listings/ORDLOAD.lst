IBM Enterprise COBOL Compile Listing
PROGRAM-ID: ORDLOAD
SOURCE-SHA256: fbf1fd69ac2ed74c8d8431e08cedd73c4396f706daa09a3a806d78d796595d90
COMPILE-STATUS: SUCCESS
CALL-XREF: ORDVAL
COPY-XREF: ORDERREC, ERRREC
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ORDLOAD.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ORDER-IN ASSIGN TO ORDIN.
           SELECT ORDER-OUT ASSIGN TO ORDOUT.
       DATA DIVISION.
       FILE SECTION.
       FD ORDER-IN RECORD CONTAINS 160 CHARACTERS.
       01 ORDER-IN-RAW PIC X(160).
       FD ORDER-OUT RECORD CONTAINS 160 CHARACTERS.
       01 ORDER-OUT-RAW PIC X(160).
       WORKING-STORAGE SECTION.
       COPY ORDERREC.
       COPY ERRREC.
       01 WS-RC PIC S9(4) COMP VALUE 0.
       PROCEDURE DIVISION USING WS-RC.
       LOAD-ORDERS.
           OPEN INPUT ORDER-IN OUTPUT ORDER-OUT
           PERFORM UNTIL ORDER-IN-RAW = HIGH-VALUES
             READ ORDER-IN AT END MOVE HIGH-VALUES TO ORDER-IN-RAW
             NOT AT END
               CALL 'ORDVAL' USING ORDER-IN-RAW WS-RC
               IF WS-RC = 0 WRITE ORDER-OUT-RAW FROM ORDER-IN-RAW END-IF
             END-READ
           END-PERFORM
           CLOSE ORDER-IN ORDER-OUT
           GOBACK.
EXPANDED-SOURCE-END
