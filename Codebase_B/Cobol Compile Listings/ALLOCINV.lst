IBM Enterprise COBOL Compile Listing
PROGRAM-ID: ALLOCINV
SOURCE-SHA256: 3fa1d20bbfd37edd1b585a79a6e54d1ae0e13565f7be17b73d4e9349181ea8a6
COMPILE-STATUS: SUCCESS
CALL-XREF: NONE
COPY-XREF: INVREC, PICKREC
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ALLOCINV.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY INVREC.
       COPY PICKREC.
       01 WS-REQUESTED PIC S9(7)V99 COMP-3.
       01 WS-AVAILABLE PIC S9(7)V99 COMP-3.
       LINKAGE SECTION.
       01 LK-RC PIC S9(4) COMP.
       PROCEDURE DIVISION USING LK-RC.
       ALLOCATE-STOCK.
           MOVE INV-AVAILABLE-QTY TO WS-AVAILABLE
           IF WS-AVAILABLE < WS-REQUESTED
              MOVE 4 TO LK-RC
           ELSE
              SUBTRACT WS-REQUESTED FROM INV-AVAILABLE-QTY
              MOVE 0 TO LK-RC
           END-IF
           GOBACK.
EXPANDED-SOURCE-END
