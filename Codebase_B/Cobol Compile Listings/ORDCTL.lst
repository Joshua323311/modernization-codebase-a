PROGRAM-ID: ORDCTL
SOURCE-SHA256: f41bb44c64780d0b209098f46f020a6b0fef90d30025a31c9214b70ab66d6c87
COMPILE-STATUS: SUCCESS
CALL-XREF: BIZDATE, ORDLOAD, INVPICK, SHIPBLD, ORDBILL, ORDRPT
COPY-XREF: NONE
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ORDCTL.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-RC PIC S9(4) COMP VALUE 0.
       01 WS-MODE PIC X VALUE 'N'.
       PROCEDURE DIVISION.
       MAIN-CONTROL.
           CALL 'BIZDATE' USING WS-RC
           IF WS-RC NOT = 0 MOVE 12 TO RETURN-CODE GOBACK END-IF
           CALL 'ORDLOAD' USING WS-RC
           IF WS-RC = 0 CALL 'INVPICK' USING WS-RC END-IF
           IF WS-RC = 0 CALL 'SHIPBLD' USING WS-RC END-IF
           IF WS-RC = 0 CALL 'ORDBILL' USING WS-RC END-IF
           CALL 'ORDRPT' USING WS-RC
           MOVE WS-RC TO RETURN-CODE
           GOBACK.
EXPANDED-SOURCE-END
