PROGRAM-ID: ADDRVAL
SOURCE-SHA256: 4b8f8b29381938c80947361b9a4d472b8922b26c1f96860a5fa766842630d961
COMPILE-STATUS: SUCCESS
CALL-XREF: NONE
COPY-XREF: ADDRREC
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ADDRVAL.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY ADDRREC.
       LINKAGE SECTION.
       01 LK-ADDRESS PIC X(80).
       01 LK-RC PIC S9(4) COMP.
       PROCEDURE DIVISION USING LK-ADDRESS LK-RC.
       VALIDATE-ADDRESS.
           MOVE 0 TO LK-RC
           IF LK-ADDRESS(1:30) = SPACES MOVE 8 TO LK-RC END-IF
           IF LK-ADDRESS(61:5) = SPACES MOVE 8 TO LK-RC END-IF
           GOBACK.
EXPANDED-SOURCE-END
