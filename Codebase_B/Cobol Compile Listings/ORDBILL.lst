IBM Enterprise COBOL Compile Listing
PROGRAM-ID: ORDBILL
SOURCE-SHA256: 25cd579f84bdf2394a52986d46987810998175b6a50fbdb363bf749d107c175d
COMPILE-STATUS: SUCCESS
CALL-XREF: TAXCALC
COPY-XREF: ORDERREC, BILLREC, TAXREC
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ORDBILL.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY ORDERREC.
       COPY BILLREC.
       COPY TAXREC.
       01 WS-RC PIC S9(4) COMP VALUE 0.
       01 WS-TAX PIC S9(9)V99 COMP-3 VALUE 0.
       PROCEDURE DIVISION USING WS-RC.
       BUILD-INVOICE.
           CALL 'TAXCALC' USING ORDER-AMOUNT WS-TAX WS-RC
           IF WS-RC = 0
              MOVE ORDER-ID TO BILL-ORDER-ID
              COMPUTE BILL-TOTAL ROUNDED = ORDER-AMOUNT + WS-TAX
           END-IF
           GOBACK.
EXPANDED-SOURCE-END
