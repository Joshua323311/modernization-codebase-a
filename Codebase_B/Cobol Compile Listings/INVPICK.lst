IBM Enterprise COBOL Compile Listing
PROGRAM-ID: INVPICK
SOURCE-SHA256: 8aef793962709b874ba0161d4e8d28bd7a895fd292004321b5ebb58c1cdb7421
COMPILE-STATUS: SUCCESS
CALL-XREF: ALLOCINV
COPY-XREF: INVREC, ORDERREC, PICKREC
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. INVPICK.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT INVENTORY-IN ASSIGN TO INVIN.
           SELECT PICK-OUT ASSIGN TO PICKOUT.
       DATA DIVISION.
       FILE SECTION.
       FD INVENTORY-IN RECORD CONTAINS 100 CHARACTERS.
       01 INVENTORY-RAW PIC X(100).
       FD PICK-OUT RECORD CONTAINS 120 CHARACTERS.
       01 PICK-RAW PIC X(120).
       WORKING-STORAGE SECTION.
       COPY INVREC.
       COPY ORDERREC.
       COPY PICKREC.
       01 WS-RC PIC S9(4) COMP VALUE 0.
       PROCEDURE DIVISION USING WS-RC.
       PICK-STOCK.
           OPEN INPUT INVENTORY-IN OUTPUT PICK-OUT
           CALL 'ALLOCINV' USING WS-RC
           CLOSE INVENTORY-IN PICK-OUT
           GOBACK.
EXPANDED-SOURCE-END
