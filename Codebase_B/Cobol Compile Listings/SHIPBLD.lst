PROGRAM-ID: SHIPBLD
SOURCE-SHA256: 043a6f43a8eba521537de3b7f33d61de5bc5a780c1ca401fd90045ecc48e3bbc
COMPILE-STATUS: SUCCESS
CALL-XREF: ADDRVAL
COPY-XREF: ORDERREC, PICKREC, SHIPREC, ADDRREC
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. SHIPBLD.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY ORDERREC.
       COPY PICKREC.
       COPY SHIPREC.
       COPY ADDRREC.
       01 WS-RC PIC S9(4) COMP VALUE 0.
       PROCEDURE DIVISION USING WS-RC.
       BUILD-SHIPMENT.
           CALL 'ADDRVAL' USING SHIP-ADDRESS WS-RC
           IF WS-RC = 0
              MOVE ORDER-ID TO SHIP-ORDER-ID
              MOVE PICK-WAREHOUSE TO SHIP-WAREHOUSE
           END-IF
           GOBACK.
EXPANDED-SOURCE-END
