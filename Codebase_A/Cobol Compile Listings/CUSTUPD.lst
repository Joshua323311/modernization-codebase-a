IBM Enterprise COBOL Compile Listing
PROGRAM-ID: CUSTUPD
SOURCE-SHA256: 15080ab84a94108a75288e1433e128b601fd9a0b18b8f7f91fae92e466a6287f
COMPILE-STATUS: SUCCESS
CALL-XREF: CUSTVAL
COPY-XREF: CUSTREC, ERRREC
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. CUSTUPD.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CUST-IN ASSIGN TO CUSTIN.
           SELECT CUST-OUT ASSIGN TO CUSTOUT.
       DATA DIVISION.
       FILE SECTION.
       FD CUST-IN.
       01 CUST-IN-REC PIC X(120).
       FD CUST-OUT.
       01 CUST-OUT-REC PIC X(120).
       WORKING-STORAGE SECTION.
       COPY CUSTREC.
       COPY ERRREC.
       01 WS-RC PIC S9(4) COMP VALUE 0.
       PROCEDURE DIVISION USING WS-RC.
       MAIN.
           OPEN INPUT CUST-IN OUTPUT CUST-OUT
           PERFORM UNTIL CUST-IN-REC = HIGH-VALUES
              READ CUST-IN AT END MOVE HIGH-VALUES TO CUST-IN-REC
              NOT AT END CALL 'CUSTVAL' USING CUST-IN-REC WS-RC
                 IF WS-RC = 0 WRITE CUST-OUT-REC FROM CUST-IN-REC END-IF
              END-READ
           END-PERFORM
           CLOSE CUST-IN CUST-OUT
           GOBACK.
EXPANDED-SOURCE-END
