PROGRAM-ID: TXNVAL
SOURCE-SHA256: 7621e652311727fdac8df452805fbb4607346b7f6aea51a37f483e4ce55bee91
COMPILE-STATUS: SUCCESS
CALL-XREF: NONE
COPY-XREF: TXNREC, CODETBL
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. TXNVAL.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY TXNREC.
       COPY CODETBL.
       LINKAGE SECTION.
       01 LK-TXN PIC X(100).
       01 LK-RC PIC S9(4) COMP.
       PROCEDURE DIVISION USING LK-TXN LK-RC.
       MAIN.
           MOVE 0 TO LK-RC
           IF LK-TXN(1:12) = SPACES MOVE 8 TO LK-RC END-IF
           IF LK-TXN(21:1) NOT = 'C' AND LK-TXN(21:1) NOT = 'D' MOVE 8 TO LK-RC END-IF
           GOBACK.
EXPANDED-SOURCE-END
