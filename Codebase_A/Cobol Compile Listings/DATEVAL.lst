IBM Enterprise COBOL Compile Listing
PROGRAM-ID: DATEVAL
SOURCE-SHA256: dba6ad1ffcfcd9bbc8eaf7ce31f1522fd3be1df8a4fb0470949e502eb67bd670
COMPILE-STATUS: SUCCESS
CALL-XREF: NONE
COPY-XREF: DATEPARM
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. DATEVAL.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY DATEPARM.
       LINKAGE SECTION.
       01 LK-RC PIC S9(4) COMP.
       PROCEDURE DIVISION USING LK-RC.
       MAIN.
           ACCEPT RUN-DATE FROM DATE YYYYMMDD
           IF RUN-MM < 1 OR RUN-MM > 12 MOVE 8 TO LK-RC ELSE MOVE 0 TO LK-RC END-IF
           GOBACK.
EXPANDED-SOURCE-END
