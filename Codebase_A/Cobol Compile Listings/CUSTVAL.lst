IBM Enterprise COBOL Compile Listing
PROGRAM-ID: CUSTVAL
SOURCE-SHA256: 6d589bc1f0eb26835e51f082f7c94a20adb3e921da545d40a24d69b3afa5239b
COMPILE-STATUS: SUCCESS
CALL-XREF: DATEVAL
COPY-XREF: CUSTREC
EXPANDED-SOURCE-BEGIN
       IDENTIFICATION DIVISION.
       PROGRAM-ID. CUSTVAL.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY CUSTREC.
       01 WS-DATE-RC PIC S9(4) COMP VALUE 0.
       LINKAGE SECTION.
       01 LK-CUST-REC PIC X(120).
       01 LK-RC PIC S9(4) COMP.
       PROCEDURE DIVISION USING LK-CUST-REC LK-RC.
       MAIN.
           MOVE 0 TO LK-RC
           IF LK-CUST-REC(1:10) = SPACES MOVE 8 TO LK-RC END-IF
           CALL 'DATEVAL' USING WS-DATE-RC
           IF WS-DATE-RC NOT = 0 MOVE 8 TO LK-RC END-IF
           GOBACK.
EXPANDED-SOURCE-END
